# Salin file ini jadi .env, lalu isi dengan nilai asli

DATABASE_URL=postgresql://user:password@ep-xxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Fase 2: Auth
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
APP_URL=http://localhost:3000
ADMIN_PANEL_URL=http://localhost:3001


# Fase 2: SSO staff (Google OAuth) — dari console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Diisi belakangan di Fase 4-5
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
FONNTE_API_KEY=