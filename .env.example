# ============================================================================
# ERCoffeeLab Backend API — Environment Variables Template (.env.example)
# Salin file ini menjadi .env lalu isi dengan nilai asli milik Anda.
# ============================================================================

# 1. Database (Neon Postgres Cloud)
DATABASE_URL=postgresql://user:password@ep-xxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Authentication & System URLs
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
APP_URL=http://localhost:3000
ADMIN_PANEL_URL=http://localhost:3001

# 3. Staff Google SSO (OAuth 2.0 Credentials from console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 4. WhatsApp Transactional & OTP Notification (Fonnte API)
FONNTE_API_KEY=your-fonnte-api-key

# 5. Email Transactional & Promo Notification (Resend API - resend.com)
RESEND_API_KEY=re_your_resend_api_key

# 6. Midtrans Payment Gateway (Sandbox / Production)
# Kunci Sandbox diawali SB-Mid-server-xxxx & SB-Mid-client-xxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false